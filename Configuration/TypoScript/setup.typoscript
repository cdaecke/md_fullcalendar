plugin {
  tx_mdfullcalendar_cal {
    view {
      templateRootPaths {
        0 = EXT:md_fullcalendar/Resources/Private/Templates/
        1 = {$plugin.tx_mdfullcalendar_cal.view.templateRootPath}
      }
      partialRootPaths {
        0 = EXT:md_fullcalendar/Resources/Private/Partials/
        1 = {$plugin.tx_mdfullcalendar_cal.view.partialRootPath}
      }
      layoutRootPaths {
        0 = EXT:md_fullcalendar/Resources/Private/Layouts/
        1 = {$plugin.tx_mdfullcalendar_cal.view.layoutRootPath}
      }
    }

    persistence {
      storagePid = {$plugin.tx_mdfullcalendar_cal.persistence.storagePid}
    }

    features {
      # If set to 1, the enable fields are ignored in BE context.
      ignoreAllEnableFieldsInBe = 0
      # Should be on by default, but can be disabled if all actions in the plugin are uncached.
      requireCHashArgumentForActionArguments = 1
    }

    settings {
      dateFormat = {$plugin.tx_mdfullcalendar_cal.settings.dateFormat}
      timeFormat = {$plugin.tx_mdfullcalendar_cal.settings.timeFormat}

      pid {
        defaultDetailPid = {$plugin.tx_mdfullcalendar_cal.settings.pid.defaultDetailPid}
      }

      # If you enable this, make sure that you have set "defaultDetailPid" and there is an
      # ext:calendarize plugin inserted on that page.
      showIcsIcalButton = {$plugin.tx_mdfullcalendar_cal.settings.showIcsIcalButton}
    }
  }

  // Use default configuration for all plugins.
  tx_mdfullcalendar_callist < plugin.tx_mdfullcalendar_cal
  tx_mdfullcalendar_caldetail < plugin.tx_mdfullcalendar_cal
}

CALENDAR_AJAX = PAGE
CALENDAR_AJAX {
  typeNum = 1573738558

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = 0
    debug = 0
    admPanel = 0
    additionalHeaders {
      10 {
        header = Content-Type: application/json
        replace = 1
      }
    }
  }

  10 = USER_INT
  10 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = MdFullcalendar
    pluginName = CalList
    vendorName = Mediadreams

    settings < plugin.tx_mdfullcalendar_cal.settings
    persistence.storagePid < plugin.tx_mdfullcalendar_cal.persistence.storagePid
  }
}

CALENDAR_DETAIL_AJAX < CALENDAR_AJAX
CALENDAR_DETAIL_AJAX {
  typeNum = 1573760945

  config.additionalHeaders {
    10 {
      header = Content-Type: text/html
      replace = 1
    }
  }

  10.pluginName = CalDetail
}
